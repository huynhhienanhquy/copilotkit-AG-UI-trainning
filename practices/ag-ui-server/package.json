{
  "name": "ag-ui-server",
  "version": "1.0.0",
  "description": "Server-based AG-UI integration practice with a streaming UI",
  "main": "dist/server.js",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names API,WEB \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:api": "tsx watch src/server.ts",
    "dev:web": "vite --config vite.config.ts",
    "start": "tsx src/server.ts",
    "build": "vite build && tsc",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.ui.json",
    "test": "tsx --test src/*.test.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.9.0",
      "onFail": "download"
    }
  },
  "type": "module",
  "dependencies": {
    "@ag-ui/core": "^0.0.59",
    "@ag-ui/encoder": "^0.0.59",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.4",
    "openai": "^7.15.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
