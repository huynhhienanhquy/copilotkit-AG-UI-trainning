{
  // The channel host imports the same local agent registry as the web route.
  // Keep its module-resolution settings aligned with the application config.
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    // src/agent.ts pulls in src/mastra/**, which uses the "@/*" alias.
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["channel-host.mts", "channels.mts", "src/agent.ts"]
}
